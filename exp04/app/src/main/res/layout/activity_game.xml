<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">
        <TextView android:id="@+id/tvScore" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp"/>
        <TextView android:id="@+id/tvHighScore" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"/>

    <Button android:id="@+id/btnRestart" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/restart_text"/>
</LinearLayout>