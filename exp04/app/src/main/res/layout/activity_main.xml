<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:theme="@style/Theme.Exp04">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </androidx.appcompat.widget.Toolbar>

    <FrameLayout android:id="@+id/fragmentContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/btnProfile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/profile_fragment"/>
    <Button android:id="@+id/btnTwoCards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/two_card_fragment"/>
    <Button android:id="@+id/btnThreeCards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/three_card_fragment"/>
</androidx.appcompat.widget.LinearLayoutCompat>